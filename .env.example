APP_NAME=WebLelang
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- WebLelang ---
# Wajibkan 2FA untuk admin & super admin (set false HANYA untuk pengembangan lokal)
AUTH_ENFORCE_2FA=true
AUCTION_REQUIRE_KYC=true
AUCTION_COMMISSION_RATE=10
AUCTION_BUYER_PREMIUM_RATE=5
AUCTION_ADMIN_FEE=0
AUCTION_INVOICE_DUE_HOURS=72
AUCTION_AUTO_CANCEL_OVERDUE=true
AUCTION_ENDING_SOON_MINUTES=15
AUCTION_CONSIGNOR_PORTAL_DAYS=30

# Rekening untuk transfer manual
PAYMENT_BANK_NAME=BCA
PAYMENT_BANK_ACCOUNT=0000000000
PAYMENT_BANK_HOLDER="PT Contoh Balai Lelang"

# --- Payment gateway (multi-driver): midtrans | xendit | simulator (lokal saja) ---
# Kosongkan PAYMENT_GATEWAY untuk menonaktifkan pembayaran online (transfer manual tetap bisa).
PAYMENT_GATEWAY=simulator
# Gateway untuk transfer keluar (payout penitip & refund jaminan). Kosong = manual.
PAYOUT_GATEWAY=simulator
PAYMENT_CHECKOUT_EXPIRY=1440
PAYMENT_AUTO_REFUND_DEPOSITS=true

# Midtrans Snap (pembayaran) + Iris (payout)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IRIS_CREATOR_KEY=
MIDTRANS_IRIS_APPROVER_KEY=
MIDTRANS_IRIS_MERCHANT_KEY=

# Xendit Invoice (pembayaran) + Disbursement (payout)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# --- Identitas penyelenggara (halaman Syarat & Ketentuan / Kebijakan Privasi) ---
LEGAL_OPERATOR_NAME="${APP_NAME}"
LEGAL_ENTITY="PT Nama Badan Usaha"
LEGAL_ADDRESS="Alamat kantor"
LEGAL_CITY=Jakarta
LEGAL_EMAIL=halo@domainanda.id
LEGAL_PRIVACY_EMAIL=privasi@domainanda.id
LEGAL_PHONE=
LEGAL_NIB=
LEGAL_AUCTION_HOUSE=
LEGAL_PICKUP_DAYS=7

# --- Produksi: keamanan, backup, monitoring (lihat docs/DEPLOY.md) ---
APP_FORCE_HTTPS=false
SESSION_SECURE_COOKIE=false
TRUSTED_PROXIES=
BACKUP_ARCHIVE_PASSWORD=
BACKUP_DISKS=backups
BACKUP_NOTIFY_EMAIL=
BACKUP_SCHEDULE=true
SENTRY_LARAVEL_DSN=
# Docker: domain untuk HTTPS otomatis (Caddy) & password root MySQL
SERVER_NAME=:80
DB_ROOT_PASSWORD=

# Cloudflare Turnstile (anti-bot untuk login/registrasi/lupa sandi/form titip). Kosong = nonaktif.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Real-time (Laravel Reverb). Kosongkan REVERB_APP_KEY = tanpa websocket, halaman memakai polling. ---
# Aktifkan: BROADCAST_CONNECTION=reverb, isi kunci (php artisan reverb:install / string acak),
# lalu jalankan `php artisan reverb:start` (Supervisor) atau COMPOSE_PROFILES=realtime di Docker.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Alamat yang dipakai SERVER untuk mengirim event ke Reverb (VPS: 127.0.0.1:8080 http).
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=*
# Alamat yang dipakai BROWSER (melalui proxy /app di Caddy/Nginx). Host kosong = domain situs.
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_PUBLIC_HOST}"
VITE_REVERB_PORT="${REVERB_PUBLIC_PORT}"
VITE_REVERB_SCHEME="${REVERB_PUBLIC_SCHEME}"
# COMPOSE_PROFILES=realtime

# Watermark teks pada foto barang publik. Teks kosong = domain dari APP_URL.
WATERMARK_ENABLED=true
WATERMARK_TEXT=
